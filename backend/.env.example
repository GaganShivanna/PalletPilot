# Copy to backend/.env and fill in. backend/.env is gitignored — never commit real keys.

# Third-party API keys (leave blank to use the stub implementations)
MUSE_API_KEY=
LLM_API_KEY=

# Provider selection: mock | sam | muse_spark | muse_image | real.
# mock is fully offline. sam/muse_spark need MUSE_API_KEY below; muse_image
# is not implemented yet (photo fallback covers it). Unknown names raise loudly.
AI_PROVIDER=mock
PROVIDER_TIMEOUT_S=60
PROVIDER_MAX_RETRIES=2
PROVIDER_MAX_CONCURRENCY=4
FEE_RATE=0.13

# Meta Model API (hosted SAM + Muse Spark inference; no local weights).
# MUSE_API_KEY is required for sam/muse_spark/real; the rest have defaults.
MUSE_BASE_URL=https://api.meta.ai/v1
MUSE_SPARK_MODEL=muse-spark-1.3
SAM_MODEL=sam-3.1
SAM_TIMEOUT_S=180
# SAM_CONCEPTS is required for SAM: 1-5 comma-separated product types, e.g.
# SAM_CONCEPTS=box,bottle,electronics. Leave blank for mock mode.
SAM_CONCEPTS=

# Where uploaded videos, frames and generated images are stored
DATA_DIR=data

# Frame sampling rate (clamped to 2-5 fps) and per-video cap
SAMPLE_FPS=3
MAX_FRAMES=300
MAX_UPLOAD_MB=500

# Comma-separated origins allowed to call the API (the dashboard)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
